NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/l5sly.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=1024
PROVIDER_MODE=mock

# Required when PROVIDER_MODE=live
DEEPGRAM_API_KEY=
DEEPGRAM_TIMEOUT_MS=300000
LLM_API_KEY=
LLM_BASE_URL=https://backend.sovereigneg.com/v1
LLM_MODEL=gpt-oss-20b
LLM_TIMEOUT_MS=480000
JEV_API_KEY=
JEV_BASE_URL=https://backend.sovereigneg.com/v1
JEV_MODEL=jev-1.13
JEV_TIMEOUT_MS=90000

# Required for YouTube URLs in live mode.
YTDLP_PATH=./bin/yt-dlp.exe
YTDLP_TIMEOUT_MS=900000
