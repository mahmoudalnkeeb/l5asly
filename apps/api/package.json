{
  "name": "@l5sly/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "dev": "concurrently -n types,server -c yellow,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node scripts/install-yt-dlp.mjs",
    "install:yt-dlp": "node scripts/install-yt-dlp.mjs",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@l5sly/contracts": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/http-client": "^0.0.1",
    "@nestjs/platform-express": "^12.1.2",
    "@tursodatabase/database": "^0.8.2",
    "bullmq": "^6.3.11",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "nestjs-pino": "^5.3.1",
    "openai": "^7.28.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
